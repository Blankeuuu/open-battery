<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Open Battery" Manufacturer="Blankeuuu" Version="$(var.ProductVersion)"
           UpgradeCode="7864321E-6268-43C8-A71C-27C26AEF33D1" Language="1033" Scope="perUser"
           InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="Lightweight device battery indicator for Windows 11 x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Open Battery is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="OpenBatteryIcon" SourceFile="$(var.BuildDir)\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="OpenBatteryIcon" />
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000" Message="Open Battery requires Windows 11 x64." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Open Battery">
          <Component Id="Application" Guid="1283276A-4808-4144-AC92-A0F6F837A5C9">
            <File Id="AppExe" Source="$(var.BuildDir)\OpenBattery.exe" KeyPath="yes" />
            <File Id="License" Source="$(var.SourceDir)\LICENSE" />
            <File Source="$(var.SourceDir)\fonts\OFL.txt" Name="JetBrainsMono-OFL.txt" />
            <File Source="$(var.SourceDir)\THIRD_PARTY_NOTICES.md" />
            <File Source="$(var.SourceDir)\third-party\zig-license.txt" />
            <File Source="$(var.SourceDir)\third-party\libcxx-license.txt" />
            <File Source="$(var.SourceDir)\third-party\libcxxabi-license.txt" />
            <File Source="$(var.SourceDir)\third-party\libunwind-license.txt" />
            <File Source="$(var.SourceDir)\third-party\mingw-license.txt" />
            <File Source="$(var.SourceDir)\third-party\wix-license.txt" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="759BA640-2E4B-4E22-8F21-22609C27276A">
        <Shortcut Id="OpenBatteryShortcut" Name="Open Battery" Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" Icon="OpenBatteryIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\Open Battery\Installer" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="Open Battery" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenu" />
    </Feature>
    <CustomAction Id="CleanUserData" FileRef="AppExe" ExeCommand="--uninstall-cleanup" Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="CleanUserData" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\installer\license.rtf" />
  </Package>
</Wix>
